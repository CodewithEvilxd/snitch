# ==============================================================================
# Snitch - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Server & Dev Settings
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# 2. Licensing & Activation Configuration (Optional)
# Target can be "pre" (staging/testing) or "pro" (production)
# ------------------------------------------------------------------------------
SNITCH_LICENSE_TARGET=pre

# --- PRE / STAGING ENVIRONMENT ---
SNITCH_PRE_BUY_LICENSE_URL=https://github.com/codewithevilxd/snitch
SNITCH_PRE_LICENSE_API_BASE_URL=https://your-pre-project.supabase.co/functions/v1
SNITCH_PRE_SUPABASE_PUBLISHABLE_KEY=your_pre_supabase_publishable_key

# --- PRO / PRODUCTION ENVIRONMENT ---
SNITCH_PRO_BUY_LICENSE_URL=https://gumroad.com/l/your-snitch-pro
SNITCH_PRO_LICENSE_API_BASE_URL=https://your-pro-project.supabase.co/functions/v1
SNITCH_PRO_SUPABASE_PUBLISHABLE_KEY=your_pro_supabase_publishable_key

# ------------------------------------------------------------------------------
# 3. Supabase & Stripe (Only if running / deploying supabase/functions)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 4. macOS Desktop Signing & Notarization (Optional: only for Mac builds)
# ------------------------------------------------------------------------------
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
